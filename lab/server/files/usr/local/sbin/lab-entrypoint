#!/usr/bin/env bash
# Writes the hash of the lab key (LAB_API_KEY, from lab/.env) where install.sh would, then hands over to systemd.
# systemd does not pass the container's environment to the services: this is the bridge.
set -euo pipefail
# The active key: with a domain (production) it is the hidden PROD_API_KEY, never shown on the page; without a domain
# (test) it is LAB_API_KEY, which lab-01's page shows and copies. Only its hash is stored.
ACTIVE_KEY="${LAB_API_KEY:-}"
[[ -n "${PUBLIC_DOMAIN:-}" && -n "${PROD_API_KEY:-}" ]] && ACTIVE_KEY="$PROD_API_KEY"
if [[ -n "$ACTIVE_KEY" ]]; then
  install -d -m 0750 -g xrcopilot-intrusion /etc/xrcopilotlab-intrusion-mcp
  printf 'ApiKeys__Hash=%s\n' "$(printf '%s' "$ACTIVE_KEY" | sha256sum | cut -d' ' -f1)" > /etc/xrcopilotlab-intrusion-mcp/env
  chgrp xrcopilot-intrusion /etc/xrcopilotlab-intrusion-mcp/env && chmod 0640 /etc/xrcopilotlab-intrusion-mcp/env
fi
# Suricata's HOME_NET: lab-01's addresses of this run (install.sh wrote the ones of the image build).
if [[ -f /etc/suricata/suricata.yaml ]]; then
  home="$(hostname -I | tr ' ' '\n' | grep -v '^$' | grep -v ':' | sed 's|$|/32|' | paste -sd, -)"
  sed -i "0,/^    HOME_NET:.*/s##    HOME_NET: \"[$home]\"#" /etc/suricata/suricata.yaml
fi
# The site, from lab/.env (SITE_*, PUBLIC_DOMAIN), in the same file install.sh writes from SITE_* and PUBLIC_URL:
# the name and place on the page's map, and with a domain XRCopilotLab's address instead of a tunnel's.
{
  if [[ -n "${SITE_NAME:-}" ]]; then printf 'Site__Name=%s\n' "$SITE_NAME"; fi
  if [[ -n "${SITE_LATITUDE:-}" && -n "${SITE_LONGITUDE:-}" ]]; then printf 'Site__Latitude=%s\nSite__Longitude=%s\n' "$SITE_LATITUDE" "$SITE_LONGITUDE"; fi
  if [[ -n "${PUBLIC_DOMAIN:-}" ]]; then printf 'Connection__PublicUrl=https://%s\n' "$PUBLIC_DOMAIN"; fi
} > /etc/xrcopilotlab-intrusion-mcp/site.env
chgrp xrcopilot-intrusion /etc/xrcopilotlab-intrusion-mcp/site.env && chmod 0640 /etc/xrcopilotlab-intrusion-mcp/site.env
exec /sbin/init
