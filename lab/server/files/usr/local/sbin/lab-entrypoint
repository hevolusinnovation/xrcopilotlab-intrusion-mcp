#!/usr/bin/env bash
# Writes the hash of the lab key (LAB_API_KEY, from lab/.env) where install.sh would, then hands over to systemd.
# systemd does not pass the container's environment to the services: this is the bridge.
set -euo pipefail
if [[ -n "${LAB_API_KEY:-}" ]]; then
  install -d -m 0750 -g xrcopilot-intrusion /etc/xrcopilotlab-intrusion-mcp
  printf 'ApiKeys__Hash=%s\n' "$(printf '%s' "$LAB_API_KEY" | sha256sum | cut -d' ' -f1)" > /etc/xrcopilotlab-intrusion-mcp/env
  chgrp xrcopilot-intrusion /etc/xrcopilotlab-intrusion-mcp/env && chmod 0640 /etc/xrcopilotlab-intrusion-mcp/env
fi
exec /sbin/init
