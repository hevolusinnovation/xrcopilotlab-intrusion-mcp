# The only part of lab-01 the Dev Tunnel reaches: the package's API (/api for a connection, /mcp for an MCP client),
# from the tunnel container only. Its own logs: what comes through the tunnel is not the lab's web traffic.
server {
    listen 8091;
    server_name _;
    access_log /var/log/nginx/tunnel-access.log;
    error_log  /var/log/nginx/tunnel-error.log;

    allow 10.77.0.0/24;
    deny  all;
    # XRCopilotLab's own API/MCP calls are not web attacks: the WAF must not inspect them.
    modsecurity off;

    # The root says what is here, so a browser does not just get a 404: addresses only, no data, no key.
    location = / {
        default_type application/json;
        add_header Cache-Control no-store always;
        return 200 '{"service":"Hevolus Intrusion MCP","api":"/api/","mcp":"/mcp","status":"/api/status","auth":"X-API-Key header on every call","note":"API del toolkit per XRCopilotLab: ogni chiamata vuole l\'intestazione X-API-Key. La mappa e la lista degli attacchi sono nella pagina di monitoraggio, dal Dev Tunnel con il login Microsoft."}\n';
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8470;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location /mcp {
        proxy_pass http://127.0.0.1:8470;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / {
        return 404;
    }
}

# The monitoring page (map and attacks) for the Dev Tunnel's second port, from the tunnel container only. The tunnel
# lets in only who logs in with Microsoft (the tunnel's owner and the owner's tenant): no password here. Read only:
# the page's own key (written by install.sh) is added here, and only GET reaches the API.
server {
    listen 8093;
    server_name _;
    access_log /var/log/nginx/xrcopilotlab-dashboard.log;

    allow 10.77.0.0/24;
    deny  all;
    modsecurity off;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;

    location = / { proxy_pass http://127.0.0.1:8470; }
    location = /index.html { proxy_pass http://127.0.0.1:8470; }
    location = /hevolus-logo.svg { proxy_pass http://127.0.0.1:8470; }
    location /vendor/ { proxy_pass http://127.0.0.1:8470; }
    # The Dev Tunnel controls (Microsoft login, create, the test key) live on this page: driven through the lab's
    # tunnel container. Lab only — a real server has no tunnel container, so these paths simply do not answer.
    location /api/tunnel/ { proxy_pass http://10.77.0.30:8092/; }
    location /api/ {
        limit_except GET { deny all; }
        include /etc/nginx/xrcopilotlab-dashboard/key.conf;
        proxy_pass http://127.0.0.1:8470;
    }
    location / { return 404; }
}
