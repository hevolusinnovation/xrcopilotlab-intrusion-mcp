# The lab's settings, read by docker compose (make lab-up creates lab/.env from this file, with a new key).

# The X-API-Key XRCopilotLab sends. lab-01 keeps only its hash. Generated by make lab-up.
# - Test (no PUBLIC_DOMAIN): LAB_API_KEY is the key, shown and copyable on lab-01's page next to the Dev Tunnel.
# - Prod (PUBLIC_DOMAIN set): PROD_API_KEY is the key, NEVER shown on the page (the Dev Tunnel section is hidden).
#   Keep it secret: it is the real key for the customer's public URL. Generated by make lab-up.
LAB_API_KEY=
PROD_API_KEY=

# The server's place on the map is found automatically from its public IP (geolocated): nothing to set here. In the
# lab, lab-01 is isolated, so the tunnel container resolves the location (the machine running the lab) and shares it.

# The lab's public domain, for a stable address. Only when the infrastructure is already in place: the DNS name points
# to this machine, the ports are open, and a reverse proxy in front terminates TLS (see README › "The lab on a domain"):
#   https://<PUBLIC_DOMAIN>/                    -> this machine:8091  API (/api, /mcp): X-API-Key on every call
#   https://<PUBLIC_DOMAIN>:<PUBLIC_PAGE_PORT>/ -> this machine:8093  monitoring page: no login of its own, so the
#                                                                     proxy decides who reaches it (VPN, office, SSO)
# Empty: no domain, the console opens a Microsoft Dev Tunnel instead (temporary test address, Microsoft login).
PUBLIC_DOMAIN=
PUBLIC_PAGE_PORT=8443
